{
  "version": 1,
  "coordinateConvention": {
    "yawPositive": "rightEarVisible",
    "note": "FISWG: +yaw shows the right ear, -yaw the left. Calibrate matrix→Euler signs to match. User-visible copy lives in src/i18n, not here.",
    "eulerOrder": "YXZ",
    "units": "degrees"
  },
  "smoothing": {
    "enabled": true,
    "oneEuro": { "minCutoff": 1.0, "beta": 0.007, "dCutoff": 1.0 }
  },
  "faceGates": {
    "minFacePresence": 0.5,
    "minTrackingConfidence": 0.5,
    "minFaceHeightRatio": 0.25,
    "maxFaceHeightRatio": 0.70
  },
  "poseTargets": {
    "rightEar": {
      "yawCenter": 80, "yawMin": 70, "yawMax": 90,
      "pitchMin": -8, "pitchMax": 8, "rollMin": -8, "rollMax": 8
    },
    "leftEar": {
      "yawCenter": -80, "yawMin": -90, "yawMax": -70,
      "pitchMin": -8, "pitchMax": 8, "rollMin": -8, "rollMax": 8
    }
  },
  "poseGuidance": {
    "rollCorrectAbove": 12,
    "pitchTooHighAbove": 12,
    "pitchTooLowBelow": -12,
    "rightEar": { "turnMoreBelow": 55, "almostBelow": 70, "tooFarAbove": 95 },
    "leftEar": { "turnMoreAbove": -55, "almostAbove": -70, "tooFarBelow": -95 }
  },
  "captureBands": {
    "nearMaxAbsYawError": 10,
    "readyMaxAbsYawError": 5,
    "readyMaxAbsPitchError": 8,
    "readyMaxAbsRollError": 8
  },
  "personalOffset": {
    "enabled": true,
    "clampDeg": 15,
    "calibrationYawMinAbs": 60,
    "calibrationYawMaxAbs": 95,
    "defaultOffset": { "leftEar": 0, "rightEar": 0 }
  },
  "stability": {
    "requiredStableFrames": 12,
    "maxDeltaYawDeg": 3,
    "maxDeltaPitchDeg": 3,
    "maxDeltaRollDeg": 3
  },
  "earRoiQuality": {
    "laplacianMin": 100,
    "brightnessMin": 60,
    "brightnessMax": 200,
    "minEdgeEnergy": 15
  },
  "promptUx": { "minDwellMs": 400, "onlyOnePrompt": true }
}
