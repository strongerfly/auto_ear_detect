{
  "version": 2,
  "captureMode": "qualityPeakYaw",
  "coordinateConvention": {
    "yawPositive": "rightEarVisible",
    "note": "FISWG: +yaw shows the right ear, -yaw the left. Calibrate matrix→Euler signs to match. User-visible copy lives in src/i18n, not here.",
    "eulerOrder": "YXZ",
    "units": "degrees"
  },
  "smoothing": {
    "enabled": true,
    "oneEuro": { "minCutoff": 1.0, "beta": 0.007, "dCutoff": 1.0 }
  },
  "faceGates": {
    "minFacePresence": 0.5,
    "minTrackingConfidence": 0.5,
    "minFaceHeightRatio": 0.25,
    "maxFaceHeightRatio": 0.70
  },
  "search": {
    "yawAbsMin": 35,
    "yawAbsMax": 90,
    "preferredAbsMin": 40,
    "preferredAbsMax": 80,
    "priorYawAbs": 60,
    "pitchMin": -10,
    "pitchMax": 10,
    "rollMin": -8,
    "rollMax": 8,
    "minSweepCoverageRatio": 0.6,
    "allowResweepOnce": true,
    "tieBreak": "smallerAbsYaw",
    "guidanceCoarseAbsError": 22,
    "slowYawDeltaDeg": 18
  },
  "score": {
    "weights": { "sharp": 0.45, "struct": 0.35, "content": 0.20 },
    "sharp": { "laplacianMinRaw": 80, "laplacianGoodRaw": 120 },
    "struct": { "minEdgeEnergy": 15, "goodEdgeEnergy": 40 },
    "content": {
      "requireSideFaceProxy": true,
      "penalizeMeatusLikeDarkBlob": true,
      "meatusPenalty": 0.25,
      "meatusCenterBrightnessBelow": 40,
      "outsidePreferredSoftPenalty": 0.1
    },
    "scoreMinAbsolute": 0.35,
    "softSuccessBelow": 0.55,
    "updateBestOnlyIfPoseOk": true,
    "ignoreFrameIfFaceLost": true
  },
  "ready": {
    "bandDegAroundBest": 5,
    "scoreRatioOfBest": 0.92,
    "stableFrames": 12,
    "maxDeltaYawDeg": 3,
    "maxDeltaPitchDeg": 3,
    "maxDeltaRollDeg": 3,
    "brightnessMin": 60,
    "brightnessMax": 200,
    "burstFrames": 3,
    "autoShutterCountdownMs": 3000,
    "pickBurstBy": "score",
    "requireUserConfirm": false,
    "pitchMaxAbs": 10,
    "rollMaxAbs": 8
  },
  "personalBest": {
    "persist": true,
    "alwaysRescore": true,
    "nextTimeNarrowSearchByDeg": 10,
    "minScoreImprove": 0.02
  },
  "poseGuidance": {
    "rollCorrectAbove": 12,
    "rollSevereAbove": 20,
    "pitchTooHighAbove": 12,
    "pitchTooLowBelow": -12
  },
  "promptUx": {
    "minDwellMs": 400,
    "crossFamilyDwellMs": 700,
    "readyPromoteMs": 200,
    "sideIntroMs": 2800,
    "slowDownPreemptMs": 0,
    "slowDownHoldMs": 900,
    "onlyOnePrompt": true
  },
  "failure": {
    "stuckNearInnerEdgeDeg": 38,
    "stuckNearOuterEdgeDeg": 88,
    "lowStructAcrossSweep": 12,
    "flatPeakRangeDeg": 25,
    "flatScoreSpan": 0.1,
    "timeoutMs": 45000,
    "maxFaceLostFrames": 15
  }
}
