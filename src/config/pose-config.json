{
  "version": 2,
  "captureMode": "qualityPeakYaw",
  "coordinateConvention": {
    "yawPositive": "rightEarVisible",
    "note": "FISWG: +yaw 露右耳，-yaw 露左耳。实现时用真机标定矩阵→Euler 符号，使与此一致。",
    "eulerOrder": "YXZ",
    "units": "degrees"
  },
  "smoothing": {
    "enabled": true,
    "oneEuro": { "minCutoff": 1.0, "beta": 0.007, "dCutoff": 1.0 }
  },
  "faceGates": {
    "minFacePresence": 0.5,
    "minTrackingConfidence": 0.5,
    "minFaceHeightRatio": 0.25,
    "maxFaceHeightRatio": 0.70
  },
  "search": {
    "rightEar": {
      "yawAbsMin": 35, "yawAbsMax": 90,
      "preferredAbsMin": 40, "preferredAbsMax": 80
    },
    "leftEar": {
      "yawAbsMin": 35, "yawAbsMax": 90,
      "preferredAbsMin": 40, "preferredAbsMax": 80
    },
    "pitchMin": -10, "pitchMax": 10, "rollMin": -8, "rollMax": 8,
    "minSweepCoverageRatio": 0.6,
    "allowResweepOnce": true,
    "tieBreak": "smallerAbsYaw",
    "priorYawAbs": 60,
    "guidanceCoarseAbsError": 22,
    "slowYawDeltaDeg": 18
  },
  "score": {
    "weights": { "sharp": 0.45, "struct": 0.35, "content": 0.20 },
    "sharp": { "laplacianMinRaw": 80, "laplacianGoodRaw": 120 },
    "struct": { "minEdgeEnergy": 15, "goodEdgeEnergy": 40 },
    "content": {
      "requireSideFaceProxy": true,
      "penalizeMeatusLikeDarkBlob": true,
      "meatusPenalty": 0.25,
      "meatusCenterBrightnessBelow": 40,
      "outsidePreferredSoftPenalty": 0.1
    },
    "scoreMinAbsolute": 0.35,
    "updateBestOnlyIfPoseOk": true,
    "ignoreFrameIfFaceLost": true
  },
  "ready": {
    "bandDegAroundBest": 5,
    "exitBandDeg": 8,
    "scoreRatioOfBest": 0.92,
    "stableFrames": 12,
    "maxDeltaYawDeg": 3,
    "maxDeltaPitchDeg": 3,
    "maxDeltaRollDeg": 3,
    "brightnessMin": 60,
    "brightnessMax": 200,
    "burstFrames": 3,
    "pickBurstBy": "score",
    "requireUserConfirm": false,
    "pitchMaxAbs": 10,
    "rollMaxAbs": 8
  },
  "personalBest": {
    "persistSessionOffset": true,
    "clampOffsetDeg": 20,
    "nextTimeNarrowSearchByDeg": 10,
    "alwaysRescore": true,
    "minScoreImprove": 0.02
  },
  "poseGuidance": {
    "rollCorrectAbove": 12,
    "rollSevereAbove": 20,
    "pitchTooHighAbove": 12,
    "pitchTooLowBelow": -12
  },
  "promptUx": {
    "minDwellMs": 400,
    "crossFamilyDwellMs": 700,
    "readyPromoteMs": 200,
    "onlyOnePrompt": true
  },
  "failure": {
    "stuckNearInnerEdgeDeg": 38,
    "stuckNearOuterEdgeDeg": 88,
    "lowStructAcrossSweep": 12,
    "flatPeakRangeDeg": 25,
    "timeoutMs": 45000,
    "maxFaceLostFrames": 15
  },
  "copy": {
    "NO_FACE": "请把脸移入取景框",
    "TOO_FAR": "请靠近一点",
    "TOO_CLOSE": "请稍远一点，露出整只耳朵",
    "FIX_ROLL": "请摆正脑袋，不要歪头",
    "PITCH_DOWN": "请稍微低头",
    "PITCH_UP": "请稍微抬头",
    "SWEEP_RIGHT_EAR": "请向左转头，慢慢找右耳最清楚的角度",
    "SWEEP_LEFT_EAR": "请向右转头，慢慢找左耳最清楚的角度",
    "TURN_MORE": "再转一点点",
    "TURN_BACK": "往回一点，刚才那边更清楚",
    "SLOW_DOWN": "请慢一点转",
    "CLEAR_HAIR": "请把耳边头发拨开",
    "BAD_LIGHT": "光线不太好，换亮一点的地方",
    "HOLD_NEAR_PEAK": "很好，请保持不动",
    "READY": "可以拍了",
    "SOFT_BEST": "已选当前最清晰角度",
    "FAIL_TIMEOUT": "还没找到清晰角度，请拨开头发后再试一次",
    "FAIL_TRACKING": "脸跟丢了，请正对屏幕后重新转头",
    "WRONG_SIDE": "方向反了：请按身体的左/右转，不是镜子",
    "RELEARN_CONFIRM": "重新找这一侧最清楚的角度？当前记录会清掉。",
    "CAMERA_DENIED": "没有摄像头权限。请在浏览器里允许后点「打开摄像头」。",
    "MIRROR_HINT": "左右以你的身体为准，不是镜子。保存的照片与自拍预览左右相反。",
    "OTHER_EAR_HINT": "这侧拍好了，需要的话再拍另一只耳朵。",
    "AUTOSHUTTER_COUNTDOWN": "自动拍摄中，点按可取消",
    "LIMITS_HINT": "会找你转头时最清楚的一帧，不是固定70–90度。"
  }
}
